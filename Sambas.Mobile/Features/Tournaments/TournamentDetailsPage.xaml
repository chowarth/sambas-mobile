<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Sambas.Mobile.Controls"
    xmlns:local="clr-namespace:Sambas.Mobile.Features.Tournaments"
    xmlns:matches="clr-namespace:Sambas.Mobile.Features.Matches"
    x:Class="Sambas.Mobile.Features.Tournaments.TournamentDetailsPage"
    Shell.PresentationMode="ModalNotAnimated">

    <Grid>
        <CollectionView
            ItemsSource="{Binding Matches}">
            <CollectionView.Header>
                <VerticalStackLayout>
                    <Border
                        Style="{StaticResource CardStyle}">
                        <VerticalStackLayout
                            Padding="16">
                            <Label
                                Style="{StaticResource LabelSemibold}"
                                FontSize="24"
                                Text="{Binding Tournament.Name}"/>
                            <Label
                                Style="{StaticResource LabelSemibold}"
                                FontSize="18"
                                Text="{Binding Tournament.StartDate, StringFormat='{0:d}'}"/>
                        </VerticalStackLayout>
                    </Border>
                    <Label
                        Margin="16, 0, 16, 16"
                        Text="Matches"
                        FontSize="18"
                        Style="{StaticResource LabelSemibold}"/>
                </VerticalStackLayout>
            </CollectionView.Header>
            
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <SwipeView Threshold="95">
                        <SwipeView.RightItems>
                            <SwipeItems Mode="Reveal">
                                <controls:SwipeItemControl
                                    Style="{StaticResource DeleteAction}"
                                    Command="{Binding x:DataType='local:TournamentDetailsPageViewModel',
                                        Source={RelativeSource AncestorType={x:Type local:TournamentDetailsPageViewModel}},
                                        Path=DeleteMatchCommand}"
                                    CommandParameter="{Binding .}"/>
                            </SwipeItems>
                        </SwipeView.RightItems>
                        <matches:MatchOverviewView/>
                    </SwipeView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <ContentView
                    HeightRequest="75"/>
            </CollectionView.Footer>
        </CollectionView>

        <Button
            Text="+"
            Style="{StaticResource FabButton}"
            Margin="16"
            VerticalOptions="End"
            HorizontalOptions="End"
            Command="{Binding AddMatchCommand}"/>
    </Grid>

</ContentPage>